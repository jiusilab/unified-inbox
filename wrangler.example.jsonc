{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "unified-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"workers_dev": true,
	// Keep variables added in the Cloudflare dashboard across deploys.
	"keep_vars": true,
	// Custom domains: the web UI (behind Cloudflare Access) and the read-only agent API host
	// (bearer tokens, not behind Access; serves /api/everest/* only). Remove if you only use workers.dev.
	"routes": [
		{ "pattern": "inbox-api.example.com", "custom_domain": true },
		{ "pattern": "mail.example.com", "custom_domain": true }
	],
	"preview_urls": false,
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
		// The worker now fails closed outside local development if Access is not configured.
		"POLICY_AUD": "your-access-application-aud-tag",
		"TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
		"DOMAINS": "example.com",
		"EMAIL_ADDRESSES": [],
		// Everything is collected into this one mailbox.
		"UNIFIED_MAILBOX": "inbox@example.com",
		// Optional legacy IMAP sources configured by env (most people add sources in Settings instead).
		// e.g. "gmail" -> Worker secrets IMAP_GMAIL_USER / IMAP_GMAIL_PASS.
		"IMAP_ACCOUNTS": "",
		"IMAP_INITIAL_DAYS": "90",
		"AGENT_API_HOST": "inbox-api.example.com"
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "unified-inbox",
			"preview_bucket_name": "unified-inbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		}
	]
}
